  "Tx00037": "பொறுப்புத் துறப்பு",
  "Tx00038": "விதிமுறைகள் மற்றும் நிபந்தனைகள்",
  "Tx00039": "பதிப்புரிமை © 2021-2025 | {0} | அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை",
  "Tx00040": "விவாதத்தில் பங்கேற்கவும்: இன்றைய பிரபலமான கேள்விகளை ஆராயுங்கள்!",
  "Tx00041": "அனைத்து தலைப்புகளையும் பார்க்கவும்",
  "Tx00042": "ஆன்லைன் தேர்வுத் தொடர்",
  "Tx00043": "{0} மூலம் எங்கிருந்தும் ஆன்லைன் தேர்வை எழுதி உங்கள் திறன்களை மேம்படுத்துங்கள்.",
  "Tx00044": "தேர்வை உருவாக்கவும்",
  "Tx00045": "குறியீடு அல்லது இணைப்பை உள்ளிடவும்",
  "Tx00046": "சேரவும்",
  "Tx00047": "பகிரக்கூடிய இணைப்பைப் பெறுங்கள்",
  "Tx00048": "நீங்கள் சந்திக்க விரும்பும் நபர்களுக்கு அனுப்பக்கூடிய இணைப்பைப் பெற <strong>நீங்களே</strong> என்பதைக் கிளிக் செய்யவும்.",
  "Tx00049": "தேர்வுத் தொடரைப் பற்றி <a href='{0}' target='_blank'>மேலும் அறிக</a>.",
  "Tx00050": "உங்கள் தேர்வு விருப்பங்களைத் தேர்ந்தெடுக்கவும்",
  "Tx00051": "பாடத்தைத் தேர்ந்தெடுக்கவும்",
  "Tx00052": "அனைத்து பாடங்களும்",
  "Tx00053": "கேள்விகளின் எண்ணிக்கையின் அடிப்படையில் தொகுப்பைத் தேர்ந்தெடுக்கவும்",
  "Tx00054": "தேர்வு கால அளவைத் தேர்ந்தெடுக்கவும்",
  "Tx00055": "தலைப்பைத் தேர்ந்தெடுக்கவும்",
  "Tx00056": "தேர்வைத் தொடங்கவும்",
  "Tx00057": "தேர்வின் பெயர்",
  "Tx00058": "வினாத்தாள்",
  "Tx00059": "மீதமுள்ள நேரம்",
  "Tx00060": "பெயர்",
  "Tx00061": "பதிவு எண்",
  "Tx00062": "சேமித்து சமர்ப்பிக்கவும்",
  "Tx00063": "சேமிக்கவும்",
  "Tx00064": "கணக்கு வகை",
  "Tx00065": "இலவசம்",
  "Tx00066": "மேம்படுத்தவும்",
  "Tx00067": "தேர்வு முயற்சி புள்ளிவிவரங்கள்",
  "Tx00068": "வெவ்வேறு காலகட்டங்களில் தேர்வு முயற்சிகளைக் கண்காணிக்கவும்.",
  "Tx00069": "புதிதாக உருவாக்கவும்",
  "Tx00070": "பயிற்சி",
  "Tx00071": "தேர்வாளரால் நடத்தப்பட்டது",
  "Tx00072": "எண்",
  "Tx00073": "பாடம்",
  "Tx00074": "வகை",
  "Tx00075": "நேரம்",
  "Tx00076": "நேர முத்திரை",
  "Tx00077": "தொடரவும்",
  "Tx00078": "நீக்கவும்",
  "Tx00079": "தேர்வெழுதுபவர்",
  "Tx00080": "சுயம்",
  "Tx00081": "முயற்சிகள்",
  "Tx00082": "இன்று",
  "Tx00083": "இந்த மாதம்",
  "Tx00084": "இந்த ஆண்டு",
  "Tx00085": "எல்லா காலமும்",
  "Tx00086": "சுயவிவரங்கள்",
  "Tx00087": "திருத்தவும்",
  "Tx00088": "கடவுச்சொல்லை மாற்றவும்",
  "Tx00089": "கடவுச்சொல்லைச் சரிபார்க்கவும்",
  "Tx00090": "ஒத்திசைக்கவும்",
  "Tx00091": "நீங்கள் ஆசிரியரா?",
  "Tx00092": "பற்றி",
  "Tx00093": "தோற்றம்",
  "Tx00094": "ஒட்டுமொத்தத் தோற்றம்",
  "Tx00095": "இது புதிய தாவல்கள், பக்கங்கள், உரையாடல் பெட்டிகள் மற்றும் பிற மெனுக்களுக்குப் பொருந்தும்.",
  "Tx00096": "தீம்",
  "Tx00097": "கணினி இயல்புநிலை",
  "Tx00098": "இருண்ட",
  "Tx00099": "ஒளி",
  "Tx00100": "மொழிகள்",
  "Tx00101": "ஆங்கிலம் (US)",
  "Tx00102": "இந்தி",
  "Tx00103": "சமஸ்கிருதம்",
  "Tx00104": "தமிழ்",
  "Tx00105": "தெலுங்கு",
  "Tx00106": "அமைப்புகளை மீட்டமைக்கவும்",
  "Tx00107": "ஒட்டுமொத்த அமைப்புகள்",
  "Tx00108": "தனிப்பயனாக்கக்கூடிய அனைத்து அமைப்புகளையும் இயல்புநிலை மதிப்புகளுக்கு மீட்டமைக்கவும்.",
  "Tx00109": "வலைத்தளம்",
  "Tx00110": "உங்கள் இணைப்புகளைத் திருத்துவது மொபைலில் மட்டுமே கிடைக்கும். {0} ஐப் பார்வையிட்டு, உங்கள் சுயவிவரத்தைத் திருத்தி, உங்கள் வாழ்க்கை வரலாற்றில் உள்ள வலைத்தளங்களை மாற்றவும்.",
  "Tx00111": "பெயர்",
  "Tx00112": "முழுப் பெயர்",
  "Tx00113": "பயனர் பெயர்",
  "Tx00114": "சுயசரிதை",
  "Tx00115": "பாலினம்",
  "Tx00116": "குறிப்பிட விரும்பவில்லை",
  "Tx00117": "பெண்",
  "Tx00118": "ஆண்",
  "Tx00119": "இது உங்கள் பொது சுயவிவரத்தின் ஒரு பகுதியாக இருக்காது.",
  "Tx00120": "மேலே உள்ள சொல்லைத் தட்டச்சு செய்யவும்",
  "Tx00121": "சமர்ப்பிக்கவும்",
  "Tx00122": "பழைய கடவுச்சொல்",
  "Tx00123": "பழைய கடவுச்சொல்லை உள்ளிடவும்",
  "Tx00124": "உங்கள் அடையாளத்தைச் சரிபார்க்க, உங்கள் கணக்குடன் தொடர்புடைய தற்போதைய கடவுச்சொல்லை உள்ளிடவும்.",
  "Tx00125": "புதிய கடவுச்சொல்",
  "Tx00126": "புதிய கடவுச்சொல்லை உள்ளிடவும்",
  "Tx00127": "உங்கள் கணக்கிற்குப் புதிய கடவுச்சொல்லை உருவாக்கவும். அது தேவையான பாதுகாப்பு வழிகாட்டுதல்களைப் பூர்த்தி செய்கிறது என்பதை உறுதிப்படுத்தவும்.",
  "Tx00128": "கடவுச்சொல்லை உறுதிப்படுத்தவும்",
  "Tx00129": "புதிய கடவுச்சொல்லை மீண்டும் உள்ளிடவும்",
  "Tx00130": "புதிய கடவுச்சொல் பொருந்துகிறதா என்பதை உறுதிப்படுத்தவும், தவறுகளைத் தவிர்க்கவும் அதை மீண்டும் உள்ளிடவும்.",
  "Tx00131": "கேப்சாவை உள்ளிடவும்",
  "Tx00132": "சரிபார்க்கவும்",
  "Tx00133": "கடவுச்சொல்",
  "Tx00134": "கடவுச்சொல்லை உள்ளிடவும்",
  "Tx00135": "இந்த முறையின் மூலம் உங்கள் உள்நுழைவு கணக்கின் கடவுச்சொல்லைச் சரிபார்க்கலாம். வெளியேறுவதற்கு முன் உங்கள் கடவுச்சொல்லை நினைவில் வைத்துக்கொள்ள இது உதவும்.",
  "Tx00136": "டாஷ்போர்டு",
  "Tx00137": "{0} முறை படிக்கப்பட்டது",
  "Tx00138": "குறிச்சொற்கள்",
  "Tx00139": "இணைப்பு",
  "Tx00140": "முந்தையது",
  "Tx00141": "உள்நுழைவு",
  "Tx00142": "இலவசமாக மருத்துவ ஆய்வைத் தொடங்கவும்",
  "Tx00143": "கடவுச்சொல்லைக் காட்டவும்",
  "Tx00144": "கடவுச்சொல்லை மறந்துவிட்டீர்களா?",
  "Tx00145": "உள்நுழைவதில் சிக்கலா?",
  "Tx00146": "உங்கள் மின்னஞ்சல், தொலைபேசி அல்லது பயனர் பெயரை உள்ளிடவும். உங்கள் கணக்கிற்குத் திரும்புவதற்கான இணைப்பை நாங்கள் அனுப்புவோம்.",
  "Tx00147": "உள்நுழைவு இணைப்பை அனுப்பவும்",
  "Tx00148": "கடவுச்சொல்லை மீட்டமைக்க முடியவில்லையா?",
  "Tx00149": "அல்லது",
  "Tx00150": "புதிய கணக்கை உருவாக்கவும்",
  "Tx00151": "உள்நுழைவுக்குத் திரும்பவும்",
  "Tx00152": "நான் <a href='/terms-and-conditions' target='_blank'>விதிமுறைகள் மற்றும் நிபந்தனைகளை</a> ஏற்கிறேன்.",
  "Tx00153": "ஏற்கனவே கணக்கு உள்ளதா? <a href='/ut/accounts/login'>உள்நுழையவும்.</a>",
  "Tx00154": "பதிவு செய்யவும்",
  "Tx00155": "இங்கே கிளிக் செய்யவும்",
  "Tx00156": "இந்தக் கணக்கு ஏற்கனவே வேறொரு சாதனத்தில் செயல்பாட்டில் உள்ளது. வெளியேறி, இந்தச் சாதனத்தில் மீண்டும் உள்நுழையவும்.",
  "Tx00157": "உங்கள் கோரிக்கை சமர்ப்பிக்கப்பட்டது",
  "Tx00158": "நன்றி! உங்கள் கோரிக்கை வெற்றிகரமாகப் பெறப்பட்டது.",
  "Tx00159": "கோரிக்கை ID",
  "Tx00160": "தொடர்புடையவற்றைப் பார்க்கவும்",
  "Tx00161": "குறிச்சொல் இடப்பட்ட கேள்விகள்",
  "Tx00162": "உங்கள் தேடலில் {0} சரியான பொருத்தங்கள் கிடைத்தன!",
  "Tx00163": "இந்தப் பக்கத்தை அணுக நீங்கள் உள்நுழைந்திருக்க வேண்டும்.",
  "Tx00164": "இந்த வலைத்தளத்தில் உள்நுழைந்த பிறகு பின்வரும் நன்மைகள் கிடைக்கும்:",
  "Tx00165": "இப்போது 65% விளம்பரங்கள் தெரியும்.",
  "Tx00166": "ஒவ்வொரு நாளும் 70% பிரீமியம் கட்டுரைகளைப் படிக்க முடியும்.",
  "Tx00167": "கருத்து தெரிவிக்க உங்களுக்கு அனுமதி கிடைக்கும்.",
  "Tx00168": "ஒருமுறை முயற்சிக்கவும்",
  "Tx00169": "பயிற்சித் தேர்வு",
  "Tx00170": "பயிற்சித் தேர்வைத் தொடங்க உங்கள் விவரங்களை உள்ளிடவும்.",
  "Tx00171": "முடிவு எண்",
  "Tx00172": "தொடர தேர்வு ID-ஐ உள்ளிடவும்.",
  "Tx00173": "தேர்வு ID",
  "Tx00174": "தேர்வு ID-ஐ உள்ளிடவும்",
  "Tx00175": "பெறவும்",
  "Tx00176": "தேடவும்",
  "Tx00177": "எங்கிருந்தும் ஆன்லைன் தேர்வை எழுதி, {0} மூலம் உங்கள் திறன்களை மேம்படுத்துங்கள்.",
  "Tx00178": "நீங்கள் சந்திக்க விரும்பும் நபர்களுக்கு அனுப்பக்கூடிய இணைப்பைப் பெற <strong>நீங்களே</strong> என்பதைக் கிளிக் செய்யவும்.",
  "Tx00179": "தலைப்பு",
  "Tx00180": "கேள்விகள்",
  "Tx00181": "நீங்களே",
  "Tx00182": "சேரவும்",
  "Tx00183": "நீங்கள் விரும்பும் கேள்விகள்! உங்களுக்குத் தேவையான பதில்கள்! ({0} கேள்விகள்)",
  "Tx00184": "விவாதத்தின் ஒரு பகுதியாகுங்கள்: இன்றைய பிரபலமான கேள்விகளை ஆராயுங்கள்!"
}
